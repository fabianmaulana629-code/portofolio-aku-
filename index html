<p>
Website personal untuk menampilkan profil, skill, dan hasil karya.
</p>
</div>

</div>

</div>

</section>

<section id="contact">

<div class="container">

<div class="title">Kontak</div>

<div class="contact-box">

<h2>Mari Berkolaborasi 🚀</h2>

<div class="contact-list">

<div class="contact-item">
📧 Email : your@email.com
</div>

<div class="contact-item">
📱 WhatsApp : +62 xxx xxxx xxxx
</div>

<div class="contact-item">
🌐 Website : www.example.com
</div>

</div>

</div>

</div>

</section>

<footer>

© <span id="year"></span> Warid — Dibuat dengan HTML, CSS & JavaScript.

</footer>

<script>
// Tahun otomatis
document.getElementById("year").textContent = new Date().getFullYear();

// Efek klik pada kartu
document.querySelectorAll(".card").forEach(card=>{
    card.addEventListener("click",()=>{
        card.animate([
            {transform:"scale(1) rotate(0deg)"},
            {transform:"scale(1.05) rotate(-2deg)"},
            {transform:"scale(1) rotate(0deg)"}
        ],{
            duration:250,
            easing:"ease"
        });
    });
});

// Efek hover tombol menggunakan JavaScript
document.querySelectorAll(".btn").forEach(btn=>{

    btn.addEventListener("mouseenter",()=>{
        btn.style.background="#7DFF91";
    });

    btn.addEventListener("mouseleave",()=>{

        if(btn.classList.contains("primary")){
            btn.style.background="#FF5D73";
        }else{
            btn.style.background="#53A7FF";
        }

    });

});
</script>

</body>
</html>
