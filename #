/* RESET */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* BODY */
body {
    font-family: Arial, sans-serif;
    background: #f0f2f5;
    color: #333;
}

/* PROFILE */
.profile {
    <
    width: 350px;
    margin: 100px auto;
    background: white;
    padding: 30px;
    text-align: center;
    border-radius: 20px;
    box-shadow: 0 5px 20px #ccc;
}

/* FOTO */
.profile img { 
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 20px;
}

/* NAMA */
.profile h1 {
    font-size: 28px;
    margin-bottom: 10px;
}

/* DESKRIPSI */
.profile p {
    color: #666;
    margin-bottom: 20px;
}

/* SKILL */
.skill {
    margin: 10px 0;
    padding: 10px;
    background: #f1f1f1;
    border-radius: 10px;
}

/* TOMBOL */
.profile button {
    background: #007bff;
    color: white;
    border: none;
    padding: 12px 25px;
    border-radius: 10px;
    cursor: pointer;
    margin-top: 15px;
}

.profile button:hover {
    background: #0056b3;
}